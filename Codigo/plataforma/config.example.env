# Modelo de configuracao do provisionamento da plataforma.
#
# Copie para ".env" e ajuste conforme o seu ambiente. Nenhum valor real de
# senha ou token deve ser versionado.
#
#   cp config.example.env .env
#   set -a && . ./.env && set +a
#   python3 provisionar_thingsboard.py

# Endereco base do ThingsBoard.
# Use o IP da maquina na rede local (e nao localhost) para que a Raspberry Pi
# consiga alcancar o servidor.
TB_URL=http://192.168.0.8:8080

# Credenciais do administrador do tenant.
TB_USER=tenant@thingsboard.org
TB_PASSWORD=troque-esta-senha

# Nome do dispositivo criado na plataforma.
TB_DEVICE=GreenPi-RPi5

# Publica o dashboard num link acessivel sem login (util na apresentacao).
TB_PUBLIC=0
